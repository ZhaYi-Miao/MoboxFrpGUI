<Window x:Class="MoboxFrpGUI.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="程序遇到了问题"
        Width="600"
        Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Topmost="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="💥" FontSize="32" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <StackPanel>
                <TextBlock Text="程序遇到了问题" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="很抱歉，程序发生了未预期的错误。" Opacity="0.7" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="12"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <TextBox x:Name="ErrorTextBox"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Cascadia Mono, monospace"
                     FontSize="12"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="您可以将错误信息发送给开发者来帮助修复问题。" Opacity="0.6" FontSize="12"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Button x:Name="CopyBtn"
                    Content="复制错误信息"
                    HorizontalAlignment="Left"
                    Click="CopyBtn_Click"
                    Padding="15,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ContinueBtn"
                        Content="尝试继续运行"
                        Click="ContinueBtn_Click"
                        Margin="0,0,10,0"
                        Padding="15,6"/>
                <Button x:Name="ExitBtn"
                        Content="退出程序"
                        Click="ExitBtn_Click"
                        Padding="15,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
