<ui:Page x:Class="MoboxFrpGUI.Pages.HomePage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
         Title="首页"
         Background="Transparent">

    <ui:ScrollViewerEx VerticalScrollBarVisibility="Auto">
        <Grid Margin="36,40,36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <xa:SimpleStackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12" Margin="0,0,0,25">
                <ui:SymbolIcon Symbol="Home" 
                               FontSize="28" 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="首页" 
                           FontSize="28" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </xa:SimpleStackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Border Width="1200" Height="630" 
                CornerRadius="16" ClipToBounds="True"
                BorderThickness="1" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.1" ShadowDepth="4"/>
                        </Border.Effect>

                        <Grid x:Name="AdGrid" Cursor="Hand" MouseLeftButtonDown="AdCard_Click" Background="Transparent">
                            <Image x:Name="ImgBing" 
                                   Source="https://api.dujin.org/bing/1920.php" 
                                   Stretch="Fill"  
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Image x:Name="ImgAd" 
                                   Opacity="0"
                                   Stretch="Fill" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>  

                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E6000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="0.6"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid Margin="48">
                                <xa:SimpleStackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="16">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource SystemAccentColorBrush}" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TxtTag" Text="公告栏" FontSize="18" Opacity="0.9" Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtNoticeTitle" Text="Mobox FRP 启动器" 
                                   FontSize="48" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" MaxWidth="700">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.6"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <TextBlock x:Name="TxtNotice" Text="体验全新的内网穿透管理，更快速、更稳定。" 
                                   FontSize="24" Foreground="White" Opacity="0.8" TextWrapping="Wrap" MaxWidth="600"/>
                                </xa:SimpleStackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button x:Name="BtnPrev" Content="&#xE760;" 
                                FontFamily="Segoe MDL2 Assets" 
                                Style="{StaticResource DefaultButtonStyle}" 
                                Foreground="White" 
                                Background="#44FFFFFF" 
                                Width="54" Height="54" Margin="8"
                                ui:ControlHelper.CornerRadius="27"
                                Click="BtnPrev_Click"/>

                                    <Button x:Name="BtnNext" Content="&#xE761;" 
                                FontFamily="Segoe MDL2 Assets" 
                                Style="{StaticResource DefaultButtonStyle}" 
                                Foreground="White" 
                                Background="#44FFFFFF" 
                                Width="54" Height="54" Margin="8"
                                ui:ControlHelper.CornerRadius="27"
                                Click="BtnNext_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2">
                <Border CornerRadius="12" Padding="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.05" ShadowDepth="1"/>
                    </Border.Effect>

                    <xa:SimpleStackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Margin="12,12,0,16">
                            <ui:SymbolIcon Symbol="ContactInfo" 
                                           Margin="0,0,10,0" 
                                           FontSize="20" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                            <TextBlock Text="用户信息" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <ui:SettingsCard Header="用户组" Padding="12" Background="Transparent" BorderThickness="0">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:SymbolIcon Symbol="People"/>
                            </ui:SettingsCard.HeaderIcon>
                            <TextBlock x:Name="TxtUserGroup" Text="加载中..." 
                                         Foreground="{DynamicResource SystemAccentColorBrush}" FontWeight="Bold"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="手机号" Padding="12" Background="Transparent" BorderThickness="0">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:SymbolIcon Symbol="Permissions"/>
                            </ui:SettingsCard.HeaderIcon>
                            <TextBlock x:Name="TxtRealNameStatus" Text="查询中..." FontWeight="SemiBold"/>
                        </ui:SettingsCard>

                        <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="12,8" Opacity="0.2"/>

                        <ui:SettingsCard Header="金币" Padding="12" Background="Transparent" BorderThickness="0">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Glyph="&#xE945;" Foreground="#FFD700"/>
                            </ui:SettingsCard.HeaderIcon>
                            <TextBlock x:Name="TxtGold" Text="0" FontWeight="SemiBold"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="银币" Padding="12" Background="Transparent" BorderThickness="0">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Glyph="&#xE945;" Foreground="#C0C0C0"/>
                            </ui:SettingsCard.HeaderIcon>
                            <TextBlock x:Name="TxtSilver" Text="0" FontWeight="SemiBold"/>
                        </ui:SettingsCard>

                        <Grid Margin="12,20,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="打开官网" Click="BtnOpenWeb_Click"
                                    HorizontalAlignment="Stretch" Height="38"
                                    Style="{StaticResource AccentButtonStyle}" 
                                    ui:ControlHelper.CornerRadius="6"/>         
                            <Button Grid.Column="2" Content="查看文档" Click="BtnOpenDoc_Click"
                                    HorizontalAlignment="Stretch" Height="38"
                                    ui:ControlHelper.CornerRadius="6"/>
                        </Grid>
                    </xa:SimpleStackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ui:ScrollViewerEx>
</ui:Page>