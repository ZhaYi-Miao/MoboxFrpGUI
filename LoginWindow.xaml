<Window x:Class="MoboxFrpGUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Icon="pack://application:,,,/Resources/logo.ico"
        Title="登录 - MoBoxFrp" Height="400" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True">
    <Grid>
        <StackPanel Margin="30" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Resources/logo.png" Height="0" Margin="0,0,0,20"/>
            <TextBlock Text="MoBoxFrp 登录" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBox x:Name="TxtAccount" 
                     ui:ControlHelper.Header="邮箱 / 手机号" 
                     ui:ControlHelper.PlaceholderText="请输入邮箱或手机号" 
                     Margin="0,0,0,15"/>

            <PasswordBox x:Name="TxtPassword" 
                         ui:ControlHelper.Header="密码" 
                         ui:ControlHelper.PlaceholderText="请输入密码" 
                         Margin="0,0,0,25"/>

            <CheckBox x:Name="ChkRemember" 
                      Content="记住密码" 
                      Margin="0,0,0,15" 
                      FontSize="12"
                      Unchecked="ChkRemember_Unchecked"/>   
            <CheckBox x:Name="ChkAutoLogin" 
                      Content="启动时自动登录" 
                      Margin="0,0,0,15" 
                      FontSize="12"
                      Checked="ChkAutoLogin_Checked"/>

            <Button x:Name="BtnLogin" 
                    Content="登 录" 
                    Click="BtnLogin_Click" 
                    IsDefault="True" 
                    Style="{StaticResource AccentButtonStyle}" 
                    HorizontalAlignment="Stretch" 
                    Height="35"/>

            <Button x:Name="BtnOfflineLogin"
                    Content="离线登录"
                    Click="BtnOfflineLogin_Click"
                    IsEnabled="False"
                    Visibility="Collapsed"
                    Style="{StaticResource DefaultButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Height="35"
                    Margin="0,10,0,0"/>

            <TextBlock x:Name="TxtStatus" 
                       Foreground="Red" 
                       Margin="0,10,0,0" 
                       HorizontalAlignment="Center" 
                       TextWrapping="Wrap" 
                       Text=""/>
        </StackPanel>
    </Grid>
</Window>