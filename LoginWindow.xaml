<Window x:Class="MoboxFrpGUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
        Icon="pack://application:,,,/Resources/logo.ico"
        Title="登录 - MoBoxFrp" 
        Height="600" Width="960"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:TitleBar.Height="34"
        ui:TitleBar.MaximizeButtonAvailability="Collapsed"
        ui:ThemeManager.IsThemeAware="True"
        ui:ThemeManager.RequestedTheme="Default"
        Background="Transparent">

    <Grid>
        <!-- 背景图：Bing 每日壁纸 -->
        <Viewbox Stretch="UniformToFill">
            <Image Source="https://api.dujin.org/bing/1920.php"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Viewbox>

        <!-- 主内容：双列布局 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：Logo + 版权信息 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 左上角 Logo + 标题 -->
                <StackPanel Grid.Row="0" Margin="36,36,0,0" Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Resources/logo.ico"
                           Width="36" Height="36" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="MoBoxFrp" FontSize="24" FontWeight="Medium" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 左下角版权信息 -->
                <StackPanel Grid.Row="2" Margin="36,0,36,40" Orientation="Vertical">
                    <TextBlock Text="内网穿透 · 简单快速" FontSize="16" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="© 2077 ZhaYi" FontSize="12" Foreground="White" Opacity="0.7"/>
                </StackPanel>
            </Grid>

            <!-- 右侧：登录卡片（亚克力毛玻璃，主题感知） -->
            <Grid Grid.Column="1" MinWidth="400" Margin="0,40,40,40">
                <Grid Width="375" HorizontalAlignment="Right">
                    <!-- 阴影 -->
                    <ui:ThemeShadowChrome Margin="2" CornerRadius="8" Depth="60" IsHitTestVisible="False"/>

                    <!-- 卡片背景 + 亚克力效果（使用主题感知的背景色） -->
                    <Border CornerRadius="8" ClipToBounds="True"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <!-- 主题感知的半透明背景填充 -->
                            <Border CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#D9FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding (ui:ThemeManager.ActualTheme), RelativeSource={RelativeSource Self}}" Value="Dark">
                                                <Setter Property="Background" Value="#D91F1F1F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- 卡片内容 -->
                            <Grid ClipToBounds="True" TextOptions.TextHintingMode="Auto">
                                <ui:ScrollViewerEx PanningMode="VerticalOnly">
                                    <xa:SimpleStackPanel Margin="24,28,24,24" Spacing="8">
                                        <!-- 标题 -->
                                        <TextBlock FontSize="20" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <Run Text="登录 "/>
                                            <Run Text="MoBoxFrp" FontWeight="Medium"/>
                                        </TextBlock>

                                        <!-- 账号输入 -->
                                        <TextBox x:Name="TxtAccount"
                                                 ui:ControlHelper.Header="邮箱 / 手机号"
                                                 ui:ControlHelper.PlaceholderText="请输入邮箱或手机号"
                                                 Margin="0,4,0,0"/>

                                        <!-- 密码输入 -->
                                        <PasswordBox x:Name="TxtPassword"
                                                     ui:ControlHelper.Header="密码"
                                                     ui:ControlHelper.PlaceholderText="请输入密码"
                                                     Margin="0,0,0,4"/>

                                        <!-- 记住密码 / 自动登录 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <CheckBox x:Name="ChkRemember"
                                                      Content="记住密码"
                                                      Margin="0,0,20,0"
                                                      FontSize="12"
                                                      Unchecked="ChkRemember_Unchecked"/>
                                            <CheckBox x:Name="ChkAutoLogin"
                                                      Content="启动时自动登录"
                                                      FontSize="12"
                                                      Checked="ChkAutoLogin_Checked"/>
                                        </StackPanel>

                                        <!-- 登录按钮 -->
                                        <Button x:Name="BtnLogin"
                                                Content="登 录"
                                                Click="BtnLogin_Click"
                                                IsDefault="True"
                                                Style="{StaticResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Height="38"
                                                Margin="0,8,0,0"
                                                FontSize="14"
                                                FontWeight="SemiBold"/>

                                        <!-- 离线登录按钮 -->
                                        <Button x:Name="BtnOfflineLogin"
                                                Content="离线登录"
                                                Click="BtnOfflineLogin_Click"
                                                IsEnabled="False"
                                                Visibility="Collapsed"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Height="38"
                                                Margin="0,4,0,0"/>

                                        <!-- 状态提示 -->
                                        <TextBlock x:Name="TxtStatus"
                                                   Foreground="Red"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text=""
                                                   FontSize="12"/>
                                    </xa:SimpleStackPanel>
                                </ui:ScrollViewerEx>

                                <!-- 加载覆盖层（登录中显示） -->
                                <Grid x:Name="LoadingOverlay"
                                      Background="{DynamicResource LayerFillColorDefaultBrush}"
                                      Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ui:ProgressRing Width="40" Height="40"
                                                         IsActive="True"
                                                         Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <TextBlock x:Name="LoadingText"
                                                   Text="正在登录..."
                                                   Margin="0,12,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
