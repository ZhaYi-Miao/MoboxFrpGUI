<ui:Page x:Class="MoboxFrpGUI.LogsPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
         Title="LogsPage"
         Background="Transparent">

    <Grid Margin="36,40,36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="实时日志" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,25" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <StackPanel x:Name="EmptyHint" 
                        VerticalAlignment="Top" 
                        HorizontalAlignment="Center" 
                        Margin="0,120,0,0" 
                        Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Message" FontSize="48" Opacity="0.2" Margin="0,0,0,15"/>
                <TextBlock Text="当前没有正在运行的隧道" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Opacity="0.6" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="请前往隧道管理页面启动，日志将在此处实时显示" 
                           FontSize="12" 
                           Opacity="0.4" 
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <ItemsControl x:Name="LogsItemsControl" 
                                ItemsSource="{Binding Source={x:Static Application.Current}, Path=GlobalTunnelList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="LogCard" 
                                    Margin="0,0,0,24" 
                                    Visibility="Collapsed" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="12" 
                                    BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.05" ShadowDepth="1"/>
                                </Border.Effect>

                                <xa:SimpleStackPanel Spacing="12">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Border Background="{DynamicResource SystemAccentColorBrush}" Width="4" Height="16" CornerRadius="2" Margin="0,0,10,0"/>
                                            <ui:FontIcon Glyph="&#xE8A5;" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="隧道运行日志" Opacity="0.5" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>

                                        <Button DockPanel.Dock="Right" 
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Click="ClearLog_Click"
                                                Padding="8,4"
                                                ui:ControlHelper.CornerRadius="4">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Delete" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="清空" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>

                                    <Border CornerRadius="8" ClipToBounds="True" Background="#1A1A1A">
                                        <TextBox IsReadOnly="True" 
                                                 Height="400"
                                                 FontSize="13"
                                                 FontFamily="Consolas, 'Cascadia Mono', 'Courier New', monospace" 
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled" 
                                                 TextWrapping="Wrap" 
                                                 AcceptsReturn="True"
                                                 Background="Transparent" 
                                                 Foreground="#E0E0E0"
                                                 BorderThickness="0"
                                                 Padding="15"
                                                 Text="{Binding FullLogText, Mode=OneWay}"
                                                 TextChanged="LogTextBox_TextChanged"/>
                                    </Border>
                                </xa:SimpleStackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter TargetName="LogCard" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasLog}" Value="True">
                                    <Setter TargetName="LogCard" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:Page>