<ui:Page x:Class="MoboxFrpGUI.LogsPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
         Title="LogsPage"
         Background="Transparent">

    <Grid Margin="36,40,36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="实时日志" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,25" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：隧道列表 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="隧道列表" FontWeight="SemiBold" FontSize="14" Margin="16,14,16,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Opacity="0.3" Margin="16,0" Grid.Row="0" VerticalAlignment="Bottom"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4,8">
                        <ItemsControl x:Name="TunnelListItemsControl"
                                      ItemsSource="{Binding Source={x:Static Application.Current}, Path=GlobalTunnelList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TunnelItem"
                                            Visibility="Collapsed"
                                            Margin="8,2" Padding="12,10" CornerRadius="6"
                                            Cursor="Hand"
                                            Tag="{Binding .}"
                                            MouseLeftButtonUp="TunnelItem_Click">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <ui:FontIcon x:Name="StatusIcon" Glyph="&#xE71C;" FontSize="14" 
                                                             DockPanel.Dock="Left" Margin="0,2,10,0"
                                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </DockPanel>
                                            <TextBlock x:Name="StatusText" Text="未运行" FontSize="11" Opacity="0.5" Margin="24,4,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter TargetName="TunnelItem" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="StatusIcon" Property="Glyph" Value="&#xF167;"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="#52C41A"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="运行中"/>
                                            <Setter TargetName="StatusText" Property="Opacity" Value="0.7"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasLog}" Value="True"/>
                                                <Condition Binding="{Binding IsRunning}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TunnelItem" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="StatusIcon" Property="Glyph" Value="&#xE915;"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="#FAAD14"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="已停止"/>
                                            <Setter TargetName="StatusText" Property="Opacity" Value="0.7"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧：日志内容 -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 日志头部 -->
                    <DockPanel LastChildFill="False" Margin="16,14,16,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SystemAccentColorBrush}" Width="4" Height="16" CornerRadius="2" Margin="0,0,10,0"/>
                            <ui:FontIcon Glyph="&#xE8A5;" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="CurrentTunnelName" Text="未选择隧道" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right" 
                                Style="{StaticResource DefaultButtonStyle}"
                                Click="ClearLog_Click"
                                Padding="10,5"
                                ui:ControlHelper.CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="清空日志" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Opacity="0.3" Margin="16,0" Grid.Row="0" VerticalAlignment="Bottom"/>

                    <!-- 日志内容区域 -->
                    <Grid Grid.Row="1">
                        <Border x:Name="LogContentBorder" CornerRadius="0,0,8,8" ClipToBounds="True" Background="#1A1A1A" Visibility="Collapsed">
                            <RichTextBox x:Name="LogRichTextBox" 
                                     IsReadOnly="True"
                                     FontSize="13"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled" 
                                     Background="Transparent" 
                                     Foreground="#E0E0E0"
                                     BorderThickness="0"
                                     Padding="16">
                                <RichTextBox.Document>
                                    <FlowDocument FontFamily="Segoe UI, Microsoft YaHei, SimSun, sans-serif"
                                                  FontSize="13"
                                                  Foreground="#E0E0E0">
                                        <Paragraph/>
                                    </FlowDocument>
                                </RichTextBox.Document>
                            </RichTextBox>
                        </Border>

                        <StackPanel x:Name="EmptyHint" 
                                    VerticalAlignment="Top" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,120,0,0" 
                                    Visibility="Visible">
                            <ui:SymbolIcon Symbol="Message" FontSize="48" Opacity="0.2" Margin="0,0,0,15"/>
                            <TextBlock Text="请选择一个隧道查看日志" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Opacity="0.6" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="启动隧道后，日志将在此处实时显示" 
                                       FontSize="12" 
                                       Opacity="0.4" 
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:Page>
