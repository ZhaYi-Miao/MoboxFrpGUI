<ui:Page x:Class="MoboxFrpGUI.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
      Title="设置"
      Background="Transparent">

    <Grid>
        <ui:ScrollViewerEx PanningMode="VerticalFirst" VerticalScrollBarVisibility="Auto">

            <xa:SimpleStackPanel MaxWidth="1000" Margin="36,40,36,32" Spacing="24">

                <!-- 页面标题 -->
                <xa:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                    <ui:FontIcon Glyph="&#xE713;" FontSize="28" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </xa:SimpleStackPanel>

                <!-- 个性化 -->
                <xa:SimpleStackPanel Spacing="12">
                    <TextBlock Text="个性化" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <xa:SimpleStackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="应用主题" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="选择你喜欢的界面颜色模式" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                                <ComboBox x:Name="ThemeComboBox" Grid.Column="2" Width="140" VerticalAlignment="Center" 
                                          SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="Default"/>
                                    <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                    <ComboBoxItem Content="深色模式" Tag="Dark"/>
                                </ComboBox>
                            </Grid>
                        </xa:SimpleStackPanel>
                    </Border>
                </xa:SimpleStackPanel>

                <!-- 账户设置 -->
                <xa:SimpleStackPanel Spacing="12">
                    <TextBlock Text="账户设置" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <xa:SimpleStackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="自动登录" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="启动程序时自动使用保存的凭据登录" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleAutoLogin" Grid.Column="2" 
                                                 Toggled="ToggleAutoLogin_Toggled" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE8AB;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#FF4D4F"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="退出登录" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="退出当前账号并返回登录页面" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                                <Button x:Name="BtnLogout" Grid.Column="2" Content="退出登录" Click="Logout_Click"
                                        Height="32" Padding="16,0" VerticalAlignment="Center"
                                        ui:ControlHelper.CornerRadius="4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Foreground" Value="#FF4D4F"/>
                                            <Setter Property="BorderBrush" Value="#40FF4D4F"/>
                                            <Style.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#15FF4D4F"/>
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#25FF4D4F"/>
                                            </Style.Resources>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </xa:SimpleStackPanel>
                    </Border>
                </xa:SimpleStackPanel>

                <!-- 调试 -->
                <xa:SimpleStackPanel Spacing="12">
                    <TextBlock Text="调试" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <xa:SimpleStackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="日志目录" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="打开日志文件所在目录" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="打开" Click="OpenLogDir_Click" Height="32" Padding="16,0"
                                        ui:ControlHelper.CornerRadius="4"/>
                            </Grid>

                            <!-- 错误详情（有异常时自动显示） -->
                            <Grid x:Name="ErrorDetailPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ui:FontIcon Glyph="&#xE7BA;" FontSize="20" VerticalAlignment="Center" Margin="0,12,16,0" Grid.Row="0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Grid.Row="0" Margin="0,12,0,0">
                                    <TextBlock Text="最近捕获的异常" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="点击通知跳转后在此处查看详情" Opacity="0.6" FontSize="12"/>
                                </StackPanel>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                    <TextBox x:Name="ErrorDetailTextBox"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             FontFamily="Consolas, Cascadia Mono, monospace"
                                             FontSize="12"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             MaxHeight="300"/>
                                </Border>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="复制详情" Click="CopyErrorDetail_Click" Height="32" Padding="16,0"
                                            ui:ControlHelper.CornerRadius="4" Margin="0,0,10,0"/>
                                    <Button Content="清除" Click="ClearErrorDetail_Click" Height="32" Padding="16,0"
                                            ui:ControlHelper.CornerRadius="4"/>
                                </StackPanel>
                            </Grid>
                        </xa:SimpleStackPanel>
                    </Border>
                </xa:SimpleStackPanel>

                <!-- 关于 -->
                <xa:SimpleStackPanel Spacing="12">
                    <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <xa:SimpleStackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE946;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="MoboxFrp GUI" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Source={StaticResource AppVersion}, StringFormat='版本 {0}'}" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                                <Button x:Name="CheckUpdateBtn" Grid.Column="2" Content="检查更新" Click="CheckUpdateBtn_Click"
                                        Height="32" Padding="16,0" VerticalAlignment="Center"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ui:ControlHelper.CornerRadius="4"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE9A5;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="项目说明" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="本程序为 MoboxFrp 社区贡献版，由社区开发者维护" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="免责声明" Click="ShowDisclaimer_Click"
                                        Height="32" Padding="16,0" VerticalAlignment="Center"
                                        ui:ControlHelper.CornerRadius="4"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Glyph="&#xE8C1;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="开源协议" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="GNU General Public License v3.0 (GPL-3.0)" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="查看源码" Click="OpenGitHub_Click"
                                        Height="32" Padding="16,0" VerticalAlignment="Center"
                                        ui:ControlHelper.CornerRadius="4"/>
                            </Grid>
                        </xa:SimpleStackPanel>
                    </Border>
                </xa:SimpleStackPanel>

                <!-- 底部信息 -->
                <TextBlock Text="Community Contributed | Not Affiliated with Mobox Management"
                           FontSize="11" Opacity="0.35" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            </xa:SimpleStackPanel>
        </ui:ScrollViewerEx>
    </Grid>
</ui:Page>
