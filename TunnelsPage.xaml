<ui:Page x:Class="MoboxFrpGUI.TunnelsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
      Title="隧道管理"
      Background="Transparent">

    <Grid Margin="36,40,36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <xa:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                <ui:FontIcon Glyph="&#xE839;" 
                             FontSize="28" 
                             VerticalAlignment="Center" 
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <TextBlock Text="隧道管理" 
                           FontSize="28" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </xa:SimpleStackPanel>
        </Grid>

        <ui:ScrollViewerEx Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TunnelsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="12" 
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.05" ShadowDepth="1"/>
                            </Border.Effect>

                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Glyph="&#xE73E;" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,12,0" FontSize="18"/>
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ID, StringFormat='ID: \{0\}'}" Opacity="0.5" Margin="10,0,0,0" VerticalAlignment="Bottom" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>

                                    <Border HorizontalAlignment="Right" CornerRadius="10" Padding="10,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#15FF0000"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Background" Value="#1500FF00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFFF4D4D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF2ECC71"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,0,0,15"/>

                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="协议类型" Grid.Row="0" Opacity="0.6" Margin="0,5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding Protocol}" 
                                           Grid.Row="0" Grid.Column="1" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemAccentColorBrush}"/>

                                <TextBlock Text="访问地址" Grid.Row="1" Opacity="0.6" Margin="0,5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBox Text="{Binding RemoteAddress}" 
                                         Grid.Row="1" Grid.Column="1" 
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorBrush}"
                                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Padding="0,2,0,2" VerticalContentAlignment="Center"
                                         SelectionBrush="{DynamicResource SystemAccentColorBrush}"
                                         Focusable="True" Cursor="IBeam" FontSize="11" Height="20"/>

                                <TextBlock Text="节点编号" Grid.Row="2" Opacity="0.6" Margin="0,5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding NodeId}" 
                                           Grid.Row="2" Grid.Column="1" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                <TextBlock Text="隧道ID" Grid.Row="3" Opacity="0.6" Margin="0,5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding ID}" 
                                           Grid.Row="3" Grid.Column="1" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                <TextBlock Text="穿透码" Grid.Row="4" Opacity="0.6" Margin="0,5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBox Text="{Binding Token}" 
                                         Grid.Row="4" Grid.Column="1" 
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         FontSize="10" Foreground="#FF9575CD"
                                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Padding="0,2,0,2" VerticalContentAlignment="Center"
                                         SelectionBrush="{DynamicResource SystemAccentColorBrush}"
                                         Focusable="True" Cursor="IBeam" ToolTip="{Binding Token}" Height="18"/>

                                <TextBlock Text="本地地址" Grid.Row="5" Opacity="0.6" Margin="0,5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}:{1}">
                                            <Binding Path="LocalIP"/>
                                            <Binding Path="LocalPort"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Text="配置文件" Grid.Row="6" Opacity="0.6" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConfigPath}" FontSize="10" Opacity="0.4" 
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" 
                                               MaxWidth="100" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <Button ToolTip="使用记事本编辑" 
                                            Click="EditConfig_Click"
                                            Padding="4" MinWidth="32" Height="32"
                                            Background="Transparent" BorderThickness="0"
                                            ui:ControlHelper.CornerRadius="4">
                                        <ui:FontIcon Glyph="&#xE70F;" FontSize="14" Opacity="0.7" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </Button>

                                    <Button ToolTip="删除隧道" 
                                            Click="Delete_Click"
                                            Padding="4" MinWidth="32" Height="32"
                                            Background="Transparent" BorderThickness="0"
                                            ui:ControlHelper.CornerRadius="4">
                                        <ui:FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="Crimson" Opacity="0.8"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                                <Grid Margin="0,15,0,0">
                                    <Button Click="Start_Click" HorizontalAlignment="Stretch" Height="36" ui:ControlHelper.CornerRadius="6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon Glyph="&#xE768;" Margin="0,0,8,0" FontSize="14"/>
                                            <TextBlock Text="启动隧道"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="Stop_Click" HorizontalAlignment="Stretch" Height="36" Foreground="White" ui:ControlHelper.CornerRadius="6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                                <Setter Property="Background" Value="Crimson"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Resources>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E52E4D"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B21830"/>
                                                </Style.Resources>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon Glyph="&#xE71A;" Margin="0,0,8,0" FontSize="14"/>
                                            <TextBlock Text="停止隧道"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:ScrollViewerEx>
    </Grid>
</ui:Page>