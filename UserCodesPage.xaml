<ui:Page x:Class="MoboxFrpGUI.UserCodesPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:xa="http://schemas.inkore.net/lib/ui/wpf"
         Title="UserCodes"
         Background="Transparent">

    <ui:Page.Resources>
        <DataTemplate x:Key="TunnelConfigFormTemplate">
            <xa:SimpleStackPanel Spacing="8" Width="320" Margin="0,10,0,0">
                <TextBlock Text="隧道备注名" Opacity="0.6" FontSize="12"/>
                <TextBox x:Name="CfgName" />

                <TextBlock Text="穿透码 ID (只读)" Opacity="0.6" FontSize="12"/>
                <TextBox x:Name="CfgID" IsReadOnly="True" Background="{DynamicResource SystemControlBackgroundComponentMeshBrush}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <xa:SimpleStackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="4">
                        <TextBlock Text="本地 IP" Opacity="0.6" FontSize="12"/>
                        <TextBox x:Name="LocalIP" />
                        <TextBlock Text="留空默认为 127.0.0.1" FontSize="10" Opacity="0.35"/>
                    </xa:SimpleStackPanel>
                    <xa:SimpleStackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="本地端口" Opacity="0.6" FontSize="12"/>
                        <TextBox x:Name="LocalPort" />
                        <TextBlock Text="留空默认为 25565" FontSize="10" Opacity="0.35"/>
                    </xa:SimpleStackPanel>
                </Grid>

                <TextBlock Text="远程开放端口" Opacity="0.6" FontSize="12"/>
                <ComboBox x:Name="RemotePort" Height="32"/>
                <TextBlock x:Name="RemotePortHint" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="(可用范围: --)"/>

                <TextBlock Text="协议类型" Opacity="0.6" FontSize="12"/>
                <StackPanel x:Name="ProtocolGroup" Orientation="Horizontal">
                    <RadioButton Content="TCP" IsChecked="True" Margin="0,0,16,0"/>
                    <RadioButton Content="UDP"/>
                </StackPanel>
            </xa:SimpleStackPanel>
        </DataTemplate>
    </ui:Page.Resources>

    <Grid Margin="36,40,36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <xa:SimpleStackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,25">
            <Button Click="CreateNewCode_Click" Style="{StaticResource AccentButtonStyle}" Height="36" ui:ControlHelper.CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Add" Margin="0,0,8,0" FontSize="16"/>
                    <TextBlock Text="创建新的穿透码" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="Refresh_Click" Width="40" Height="36" ui:ControlHelper.CornerRadius="6">
                <ui:SymbolIcon Symbol="Refresh"/>
            </Button>
        </xa:SimpleStackPanel>

        <ui:ProgressBar x:Name="LoadingProgressBar" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,15"/>

        <ListBox x:Name="CodesDataGrid" 
                 Grid.Row="2"
                 ItemsSource="{Binding CodeList}"
                 Background="Transparent" 
                 BorderThickness="0"
                 Padding="0,0,10,0"
                 Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,16"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.05" ShadowDepth="1"/>
                        </Border.Effect>

                        <xa:SimpleStackPanel Spacing="16">
                            <DockPanel LastChildFill="False">
                                <xa:SimpleStackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="8">
                                    <TextBlock Text="穿透码 #" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding codeID}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Border Background="#28C76F" CornerRadius="4" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="有效" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <ui:FontIcon Glyph="&#xE774;" Margin="8,0,0,0" FontSize="16" Opacity="0.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding node}" Opacity="0.5" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </xa:SimpleStackPanel>

                                <xa:SimpleStackPanel Orientation="Horizontal" DockPanel.Dock="Right" Spacing="8" Panel.ZIndex="99">
                                    <Button Content="续费" Click="Renew_Click" Style="{StaticResource AccentButtonStyle}" ui:ControlHelper.CornerRadius="4"/>
                                    <Button Content="升配" Click="Upgrade_Click" ui:ControlHelper.CornerRadius="4"/>
                                    <Button Content="删除" Click="Delete_Click" Foreground="{DynamicResource SystemFillColorCriticalBrush}" ui:ControlHelper.CornerRadius="4"/>
                                    <Button Content="配置隧道" Click="Config_Click" Style="{StaticResource AccentButtonStyle}" ui:ControlHelper.CornerRadius="4"/>
                                </xa:SimpleStackPanel>
                            </DockPanel>

                            <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Opacity="0.2"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <xa:SimpleStackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="┃ 基本信息" Foreground="{DynamicResource SystemAccentColorBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Token (穿透密钥)" Opacity="0.5" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding token}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Button Click="Copy_Click" Padding="4" Margin="6,0,0,0" Background="Transparent" BorderThickness="0">
                                            <ui:FontIcon Glyph="&#xE8C8;" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="带宽限制" Opacity="0.5" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding band, StringFormat={}{0} Mbps}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </xa:SimpleStackPanel>

                                <xa:SimpleStackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="┃ 端口配置" Foreground="{DynamicResource SystemAccentColorBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="服务器端口" Opacity="0.5" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding portServer}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="允许开放范围" Opacity="0.5" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding portOpen}" Foreground="{DynamicResource SystemAccentColorLight1Brush}" FontWeight="SemiBold"/>
                                </xa:SimpleStackPanel>

                                <xa:SimpleStackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="┃ 时间信息" Foreground="{DynamicResource SystemAccentColorBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="创建日期" Opacity="0.5" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CreateTimeDisplay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="到期日期" Opacity="0.5" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ExpireTimeDisplay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </xa:SimpleStackPanel>
                            </Grid>
                        </xa:SimpleStackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</ui:Page>